#!/usr/bin/env bash
# ==============================================================================
# Bluetooth Setup Script for Arch Linux
# ==============================================================================
# Installs and enables Bluetooth support with a GUI management tool.
#
# Environment variables for chroot-aware operation:
#   CHROOT_TARGET  - Target mount point (e.g., "/mnt") for installer mode
#   NONINTERACTIVE - Skip confirmation prompts when set to "1"
#
# ==============================================================================

set -e

# Shared helpers (logging, chroot-aware run_cmd/pkg_install/svc_enable).
# Resolved relative to this script so it works from the repo too.
SETUP_LIB="$(dirname "$(readlink -f "$0")")/../lib/setup-common.sh"
[[ -f "$SETUP_LIB" ]] || SETUP_LIB="/usr/local/lib/setup-common.sh"
# shellcheck source=../lib/setup-common.sh
source "$SETUP_LIB"

# =============================================================================
# Main Script
# =============================================================================

info "Bluetooth Setup"
echo

# Check for Bluetooth hardware (only in non-chroot mode)
if [[ -z "$CHROOT_TARGET" ]]; then
    if ! lsusb | grep -qi bluetooth && ! lspci | grep -qi bluetooth; then
        warn "No Bluetooth hardware detected. Proceeding anyway..."
    fi
fi

# Packages to install
PACKAGES=(
    "bluez"           # Bluetooth protocol stack
    "bluez-utils"     # bluetoothctl and other utilities
    # "blueman"       # GTK Bluetooth manager (tray applet) (using bluetui in target-packages.x86_64
)

info "The following packages will be installed:"
for pkg in "${PACKAGES[@]}"; do
    echo "  - $pkg"
done
echo

# Skip confirmation in non-interactive mode
if [[ "$NONINTERACTIVE" != "1" ]]; then
    read -p "Continue? [Y/n] " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Nn]$ ]]; then
        echo "Aborted."
        exit 0
    fi
fi

# Install packages
info "Installing Bluetooth packages..."
pkg_install "${PACKAGES[@]}"

# Enable and start the Bluetooth service
info "Enabling Bluetooth service..."
svc_enable bluetooth.service
svc_start bluetooth.service

# Auto-power on Bluetooth adapter
info "Configuring Bluetooth to auto-power on..."
BLUETOOTH_CONF="$(target_path /etc/bluetooth/main.conf)"
if [[ -f "$BLUETOOTH_CONF" ]]; then
    # Flip an existing setting (commented or not) in place
    sed -i -E 's/^#?AutoEnable=(true|false)/AutoEnable=true/' "$BLUETOOTH_CONF"
    # Otherwise insert it inside [Policy] - bluez ignores the key in any
    # other section, so a bare append at end-of-file may not take effect
    if ! grep -q "^AutoEnable=true" "$BLUETOOTH_CONF"; then
        if grep -q '^\[Policy\]' "$BLUETOOTH_CONF"; then
            sed -i '/^\[Policy\]/a AutoEnable=true' "$BLUETOOTH_CONF"
        else
            printf '\n[Policy]\nAutoEnable=true\n' >> "$BLUETOOTH_CONF"
        fi
    fi
fi

echo
info "Bluetooth setup complete!"
if [[ -z "$CHROOT_TARGET" ]]; then
    info "You can use 'bluetoothctl' for CLI."
    info "To pair: bluetoothctl -> scan on -> pair <MAC> -> connect <MAC>"
    info "Optional: Install 'bluetui' or 'blueman' for GUI/TUI frontends."
fi
