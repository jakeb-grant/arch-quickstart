# AUR packages installed on the target system
# One package per line, comments starting with # are ignored
#
# Note: yay-bin is built first manually, then yay installs the rest.
# yay handles dependency resolution automatically, so order doesn't matter.

# Yay AUR helper (always built first)
yay-bin

# Shell
quickshell-git

# Awww wallpaper system
awww-git

# Dev tools
bruno-bin
claude-code
railwayapp-cli

# Applications
1password
1password-cli
google-chrome
localsend-bin
obsidian-bin
onlyoffice-bin
slack-desktop
spotify
ventoy-bin
vesktop-bin

# Utilities
downgrade
hyprpier-git
pane-fm-git
phylax-git
upkeep-git
