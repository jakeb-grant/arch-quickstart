# Target system packages
# Clean Hyprland desktop installation

# =============================================================================
# Base System
# =============================================================================
base
base-devel
linux
linux-firmware
linux-headers

# Bootloader
grub
efibootmgr

# Filesystem
btrfs-progs
dosfstools
e2fsprogs
ntfs-3g

# Hardware support
amd-ucode
intel-ucode
sof-firmware

# =============================================================================
# Desktop Environment - Hyprland
# =============================================================================

# Core
hyprland
greetd
greetd-tuigreet
hypridle
hyprlock

# Wayland support
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
qt5-wayland
qt6-wayland

# Desktop tooling
# (bar, launcher, notifications, polkit prompt and lock screen come from
# Strand, which is not a pacman package; see the dotfiles)
awww
grim
hyprpicker
libqalculate
slurp
wf-recorder
wl-clipboard
wtype

# Theming (adw-gtk-theme is the GTK3 base theme-switch recolours)
adw-gtk-theme
qt5ct

# =============================================================================
# Hardware Controls
# =============================================================================
bolt
brightnessctl
power-profiles-daemon
udisks2

# =============================================================================
# Camera (MIPI webcams, e.g. Intel IPU7; relayed to a v4l2loopback device)
# =============================================================================
# Installed everywhere for the author's IPU7 laptop; the dotfiles only wire
# them up on matching hardware. Costs one extra DKMS build per kernel update.
libcamera
libcamera-ipa
libcamera-tools
pipewire-libcamera
gst-plugin-libcamera
gst-plugins-good
v4l2loopback-dkms
v4l-utils

# =============================================================================
# Audio
# =============================================================================
pipewire
pipewire-alsa
pipewire-jack
pipewire-pulse
wireplumber
alsa-utils

# =============================================================================
# Networking
# =============================================================================
impala
iptables
iwd
socat

# =============================================================================
